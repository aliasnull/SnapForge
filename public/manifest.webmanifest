{
  "name": "SnapForge - Private Browser Image Tools",
  "short_name": "SnapForge",
  "description": "Resize, compress, convert, crop and rotate images directly in your browser. No uploads, no accounts, no waiting. Your images never leave your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#08090c",
  "theme_color": "#08090c",
  "categories": ["photo", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
